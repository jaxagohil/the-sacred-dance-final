{
  "expo": {
    "name": "Sacred Dance",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "sacreddance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sacreddance.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,

"NSMicrophoneUsageDescription": "Sacred Dance uses your microphone to capture spoken reflections for processing. Your voice recording is not permanently stored.",

"NSCameraUsageDescription": "Sacred Dance uses your camera so you can capture an image to include in a personal reflection. The image is used for processing and is not permanently stored.",

"NSPhotoLibraryUsageDescription": "Sacred Dance uses your photo library so you can select an image to include in a personal reflection. The image is used for processing and is not permanently stored." }
    },
    "android": {
      "package": "com.sacreddance.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {},
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0a6e1dba-106c-4f71-b7ef-39a79769d95f"
      }
    },
    "owner": "jaxagohil"
  }
}
